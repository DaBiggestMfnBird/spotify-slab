{
  "name": "slab",
  "version": "0.6.0",
  "private": true,
  "description": "SLAB — Third Coast playback moods for Spicetify",
  "type": "module",
  "scripts": {
    "build": "bun run build.mjs",
    "watch": "bun run build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "gen:neon": "bun scripts/gen-neon.ts",
    "gen:fonts": "bun scripts/gen-fonts.ts",
    "inject": "bun run build.mjs && bun scripts/dev-inject.mjs",
    "deploy": "bun run build.mjs && bun scripts/deploy.mjs",
    "dsp": "./scripts/build-dsp.sh release",
    "dsp:install": "./scripts/build-dsp.sh release && ./scripts/install-dsp.sh"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@types/bun": "^1.4.4",
    "esbuild": "^0.25.0",
    "subset-font": "^2.9.0",
    "typescript": "^5.7.2"
  }
}
